<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        
        .menu-table {
            width: 100%;
            border-collapse: collapse; 
            text-align: center;
            margin-bottom: 20px;
        }
       
        .menu-table a {
            text-decoration: none; 
            color: black;
            font-weight: bold;
        }
    </style>
</head>
<body>

    
    <table class="menu-table">
        <tr>
            <td><a href="@Url.Action("Index", "Student")">Index</a></td>
            <td><a href="@Url.Action("CalculateForm", "Calculate")">Calculate Form</a></td>
            <td><a href="@Url.Action("UserList", "Account")">UserList</a></td>
            <td><a href="@Url.Action("MyDetail", "Student")">My Detail</a></td>
            <td><b>User Id : @(TempData.Peek("UserId") ?? "XXX")</b></td>
        </tr>
    </table>

    
    <div style="padding: 10px;">
        @RenderBody()
    </div>

</body>
</html>